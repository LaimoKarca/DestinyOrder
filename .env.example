# ==============================================================================
# DestinyOrder 根目錄環境變數範本 (.env.example)
# ==============================================================================
# 讀取範圍說明（重要）：
# 1) 專案根目錄的 `.env` 僅由 Docker Compose (`docker-compose.yml`) 進行變數插值讀取。
# 2) 本機直接啟動 Python 後端 (`uvicorn` / `python backend/main.py`) 時，不會自動載入 `.env`，
#    請直接以 Shell 環境變數（例如 PowerShell `$env:DESTINYORDER_PORT="8000"`）指定。
# 3) 本機直接啟動前端 Vite 時，Vite 的 envDir 為 `frontend/`，請使用 `frontend/.env.local`
#    （可參考 `frontend/.env.example`）或 Shell 環境變數，切勿將含 Tunnel Token 的根目錄 `.env` 複製進 `frontend/`。

# --- Docker Compose 建置與選用 Profile 變數 ---
# 傳遞給 frontend 容器建置階段的網站公開基準 Origin
VITE_SITE_URL=http://127.0.0.1:5173

# 僅在啟用 `docker compose --profile tunnel up -d` 時需要填入 Cloudflare Tunnel Token
CLOUDFLARED_TOKEN=your-cloudflare-tunnel-token-here

# --- 本機 Shell 環境變數參考（供 PowerShell / Bash 匯出使用，預設無需修改） ---
# DESTINYORDER_HOST=127.0.0.1
# DESTINYORDER_PORT=8000
# DESTINYORDER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DESTINYORDER_DATA_ROOT=
# DESTINYORDER_FUNDS_DATA_ROOT=
# BACKEND_API_TARGET=http://127.0.0.1:8000
# VITE_BGM_URL=
